"""
PROJETO 5 ELEMENTO / GEMINIDONI
Módulo de Alquimia Alimentar e Mapeamento Metabólico
"""

class PerfilMetabolico:
    def __init__(self, peso=131.95, altura_cm=185.0, idade=53):
        self.peso = peso
        self.altura_cm = altura_cm
        self.idade = idade

    def calcular_tmb(self):
        """Fórmula Mifflin-St Jeor"""
        return (10 * self.peso) + (6.25 * self.altura_cm) - (5 * self.idade) + 5

    def calcular_gasto_passos(self, passos):
        """Cálculo proporcional de gasto por passos da palmilha"""
        fator_peso = self.peso / 70.0
        return passos * 0.04 * fator_peso

class AlquimiaAlimentar:
    @staticmethod
    def indice_saciedade(proteinas_g, fibras_g, volume_ml):
        """Calcula o índice de saciedade aproximado de uma refeição/hack"""
        pontuacao = (proteinas_g * 1.5) + (fibras_g * 2.0) + (volume_ml * 0.05)
        return min(pontuacao, 100.0)

def menu_alquimia():
    perfil = PerfilMetabolico()
    tmb = perfil.calcular_tmb()

    print("=" * 55)
    print("      🧪 MÓDULO ALQUIMIA PYTHON — PROJETO 5 ELEMENTO")
    print("=" * 55)
    print(f"📊 TMB Base: {tmb:.2f} kcal")
    print("-------------------------------------------------------")
    print("1. Estimativa de Saciedade (HAKs de Alquimia)")
    print("2. Simulação de Déficit com Passos")
    print("-------------------------------------------------------")

    opcao = input("Escolha uma opção (1 ou 2): ")

    if opcao == "1":
        p = float(input("Proteínas (g): "))
        f = float(input("Fibras (g): "))
        v = float(input("Volume total (ml/g): "))
        score = AlquimiaAlimentar.indice_saciedade(p, f, v)
        print(f"\n✨ Índice de Saciedade Calculado: {score:.1f} / 100")
    elif opcao == "2":
        passos = int(input("Passos registrados na palmilha: "))
        gasto_passos = perfil.calcular_gasto_passos(passos)
        print(f"\n🔥 Gasto estimado pelos passos: {gasto_passos:.2f} kcal")
    else:
        print("Opção inválida.")

if __name__ == "__main__":
    menu_alquimia()
