"""
PROJETO 5 ELEMENTO / GEMINIDONI
Calculadora Interativa Diária - Donizete
"""

PESO_ATUAL_KG = 131.95
ALTURA_CM = 185.0
IDADE_ANOS = 53

def calcular_tmb():
    # Fórmula Mifflin-St Jeor para TMB
    return (10 * PESO_ATUAL_KG) + (6.25 * ALTURA_CM) - (5 * IDADE_ANOS) + 5

def estimar_gasto_passos(passos):
    fator_peso = PESO_ATUAL_KG / 70.0
    return passos * 0.04 * fator_peso

def main():
    tmb = calcular_tmb()
    gasto_rotina = tmb * 1.2
    
    print("=" * 50)
    print("      PROJETO 5 ELEMENTO - DIAGNÓSTICO DIÁRIO")
    print("=" * 50)
    print(f"👤 Perfil: {PESO_ATUAL_KG} kg | 1.85m | 53 anos")
    print(f"🔥 Metabolismo Basal (TMB): {tmb:.2f} kcal")
    print("-" * 50)
    
    try:
        passos = int(input("🚶 Digite o total de passos hoje (palmilha): "))
        calorias = float(input("🍽️ Digite o total de calorias consumidas (kcal): "))
        
        gasto_passos = estimar_gasto_passos(passos)
        gasto_total = gasto_rotina + gasto_passos
        balanco = calorias - gasto_total
        
        print("\n" + "=" * 50)
        print("                  RESULTADO DO DIA")
        print("=" * 50)
        print(f"⚡ Gasto Energético Total: {gasto_total:.2f} kcal")
        print(f"📥 Calorias Ingeridas: {calorias:.2f} kcal")
        
        if balanco < 0:
            print(f"✅ DÉFICIT ATINGIDO: -{abs(balanco):.2f} kcal")
            print("Excelente! Seu corpo usou gordura armazenada como energia.")
        elif balanco > 0:
            print(f"⚠️ SUPERÁVIT CALÓRICO: +{balanco:.2f} kcal")
            print("Atenção: Ingestão acima do consumo energético.")
        else:
            print("⚖️ BALANÇO NEUTRO: Peso mantido.")
        print("=" * 50)
        
    except ValueError:
        print("\n❌ Por favor, digite apenas números válidos.")

if __name__ == "__main__":
    main()
